# =============================================================================
# Alexandria — environment configuration
# =============================================================================
# Copy to `.env` and fill in. Values shown are safe local-dev defaults unless
# noted otherwise. Variables are grouped into REQUIRED (set these) and OPTIONAL
# (have working defaults in code; override only if needed).
#
# Backends read these via `alexandria_core.core.config.Settings` (pydantic-
# settings; case-insensitive). The Next.js frontend reads only the NEXT_PUBLIC_*
# vars, which are exposed to the browser.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------------

# Database — docker-compose builds the backend DATABASE_URL from these three.
# (For a non-Docker local run, set DATABASE_URL directly under OPTIONAL instead.)
POSTGRES_USER=forgewriter
POSTGRES_PASSWORD=forgewriter
POSTGRES_DB=forgewriter

# Redis (RQ background-job queue + AI service).
REDIS_URL=redis://localhost:6379

# Auth — single-user local app (JWT). CHANGE these for any shared/deployed env.
SECRET_KEY=change-me-to-a-random-64-char-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Provider API-key encryption key (Fernet, urlsafe-base64, 32 bytes).
# REQUIRED for CLOUD providers (Gemini / OpenRouter / OpenAI / Anthropic): their
# API keys are encrypted at rest with this key.
#
# It is NOT needed to boot the services and NOT needed for local Ollama. The AI
# service starts fine without it; it raises a clear RuntimeError only on the
# FIRST provider operation that must encrypt/decrypt a key (it does NOT crash at
# boot, and never auto-generates an ephemeral key — that would make previously
# stored ciphertext undecryptable).
#
# Generate a fresh key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Paste it below. NEVER commit a real key to source control.
PROVIDER_ENCRYPTION_KEY=

# Frontend → backend base URLs (Next.js, exposed to the browser).
# Domain service (projects/books/chapters/scenes/codex/exports/revisions/auth):
NEXT_PUBLIC_API_URL=http://localhost:8000
# AI service (Alexandria split): /ai/*, /providers/*, /jobs live here:
NEXT_PUBLIC_AI_URL=http://localhost:8001


# -----------------------------------------------------------------------------
# OPTIONAL (code has working defaults; override only if needed)
# -----------------------------------------------------------------------------

# CORS — comma/JSON list of allowed browser origins for the backends.
ALLOWED_ORIGINS=http://localhost:3000

# AI / Ollama (local inference via LiteLLM).
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_LOCAL_MODEL=ollama/llama3.2

# Direct database URL for the backends. docker-compose sets this from the
# POSTGRES_* vars above; uncomment to override for a non-Docker local run.
# DATABASE_URL=postgresql+asyncpg://forgewriter:forgewriter@localhost:5432/forgewriter

# JWT tuning (alexandria_core defaults shown). Rarely changed.
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Hard ceiling (seconds) for a single outbound LLM completion. On timeout the
# call surfaces as a clean sanitized failure (failed job + 502), never a hang.
# AI_REQUEST_TIMEOUT=60

# Build-time fallback bearer token for the frontend. When set, the API client
# uses it if no token is in localStorage (handy for local dev / preview). Leave
# unset in normal use — the browser stores the real token after login.
# NEXT_PUBLIC_DEV_TOKEN=

# Cloud providers (V1). Provider keys are normally configured + encrypted via
# the in-app provider settings (using PROVIDER_ENCRYPTION_KEY above); these env
# vars are the LiteLLM-native fallback that LiteLLM reads directly.
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=
