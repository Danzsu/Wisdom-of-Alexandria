# Database
POSTGRES_USER=forgewriter
POSTGRES_PASSWORD=forgewriter
POSTGRES_DB=forgewriter

# Redis
REDIS_URL=redis://localhost:6379

# Auth
SECRET_KEY=change-me-to-a-random-64-char-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# AI / Ollama
OLLAMA_BASE_URL=http://ollama:11434
DEFAULT_LOCAL_MODEL=ollama/llama3.2

# Provider API-key encryption (REQUIRED — no default; the app fails to start
# without it). Encrypts AI provider API keys at rest. Generate a fresh key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Paste the generated key below. Never commit a real key to source control.
PROVIDER_ENCRYPTION_KEY=

# Frontend
ALLOWED_ORIGINS=http://localhost:3000

# Optional: Google AI Studio (V1)
# GOOGLE_API_KEY=

# Optional: OpenRouter (V1)
# OPENROUTER_API_KEY=
