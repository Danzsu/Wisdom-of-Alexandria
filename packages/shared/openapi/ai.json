ll"}], "title": "Prompt Version"}, "revision_type": {"title": "Revision Type", "type": "string"}, "scene_id": {"anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}], "title": "Scene Id"}, "updated_at": {"format": "date-time", "title": "Updated At", "type": "string"}}, "required": ["id", "scene_id", "job_id", "content", "approved", "revision_type", "model_name", "prompt_version", "created_at", "updated_at"], "title": "RevisionRead", "type": "object"}, "RewriteRequest": {"properties": {"instruction": {"title": "Instruction", "type": "string"}, "max_tokens": {"anyOf": [{"maximum": 32768.0, "minimum": 1.0, "type": "integer"}, {"type": "null"}], "title": "Max Tokens"}, "model": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Model"}, "scene_id": {"anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}], "title": "Scene Id"}, "selected_text": {"title": "Selected Text", "type": "string"}, "temperature": {"anyOf": [{"maximum": 2.0, "minimum": 0.0, "type": "number"}, {"type": "null"}], "title": "Temperature"}}, "required": ["selected_text", "instruction"], "title": "RewriteRequest", "type": "object"}, "SummarizeRequest": {"properties": {"chapter_id": {"anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}], "title": "Chapter Id"}, "content": {"title": "Content", "type": "string"}, "content_type": {"default": "jelenet", "title": "Content Type", "type": "string"}, "max_tokens": {"anyOf": [{"maximum": 32768.0, "minimum": 1.0, "type": "integer"}, {"type": "null"}], "title": "Max Tokens"}, "model": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Model"}, "scene_id": {"anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}], "title": "Scene Id"}, "temperature": {"anyOf": [{"maximum": 2.0, "minimum": 0.0, "type": "number"}, {"type": "null"}], "title": "Temperature"}}, "required": ["content"], "title": "SummarizeRequest", "type": "object"}, "ValidationError": {"properties": {"ctx": {"title": "Context", "type": "object"}