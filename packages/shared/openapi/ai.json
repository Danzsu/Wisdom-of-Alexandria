"Validation Error"}}, "security": [{"OAuth2PasswordBearer": []}], "summary": "Summarize Chapter", "tags": ["ai"]}}, "/api/v1/ai/continuity": {"post": {"description": "Continuity-check a scene against the project codex (B3).\n\nReturns STRUCTURED warnings (severity / message / entity) \u2014 analysis, not\ngenerated content, so there is NO revision. An empty ``warnings`` list is a\npositive \"no issues found\" result.\n\nDegradation contract (no 500 for either case):\n- RAG/embeddings unconfigured \u2192 the check still runs on the scene text alone\n  (empty ``context_entities``).\n- ``scene_id`` resolves to no scene / empty content \u2192 an empty result\n  (``warnings: []``, ``context_entities: []``), NOT a 404. The UI shows the\n  positive \"no issues\" state; there is simply nothing to check.", "operationId": "continuity_api_v1_ai_continuity_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ContinuityRequest"}}}, "required": true}, "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ContinuityResult"}}}, "description": "Successful Response"}, "422": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}, "description": "Validation Error"}}, "security": [{"OAuth2PasswordBearer": []}], "summary": "Continuity", "tags": ["ai"]}}, "/api/v1/ai/describe": {"post": {"operationId": "describe_api_v1_ai_describe_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/DescribeRequest"}}}, "required": true}, "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/AIDescribeResult"}}}, "description": "Successful Response"}, "422": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}, "description": "Validation Error"}}, "security": [{"OAuth2PasswordBearer": []}], "summary": "Describe", "tags": ["ai"]}}, "/api/v1/ai/generate-scene": {"post": {"operationId": "generate_scene_api_v1_ai_generate_scene_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/GenerateSceneRequest"}}}, "required": true}, "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/AIResult"}}}, "description": "Successful Response"}, "422": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}, "description": "Validation Error"}}, "security": [{"OAuth2PasswordBearer": []}], "summary": "Generate Scene", "tags": ["ai"]}}, "/api/v1/ai/index": {"post": {"description": "Re-index a project's RAG content (Codex + manuscript).\n\n``project_id`` may be given as a query param (preferred) or in the body.\nWhen no embedding provider is configured, RAG is unconfigured: this returns\nzeroed counts with ``skipped_no_provider=True`` (a 200, not an error \u2014 cloud\nembeddings are optional).", "operationId": "index_project_api_v1_ai_index_post", "parameters": [{"in": "query", "name": "project_id", "required": false, "schema": {"anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}], "title": "Project Id"}}], "requestBody": {"content": {"application/json": {"schema": {"anyOf": [{"$ref": "#/components/schemas/IndexRequest"}, {"type": "null"}], "title": "Body"}}}}, "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/IndexResult"}}}, "description": "Successful Response"}, "422": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}, "description": "Validation Error"}}, "security": [{"OAuth2PasswordBearer": []}], "summary": "Index Project", "tags": ["ai"]}}, "/api/v1/ai/index/async": {"post": {"description": "Enqueue an async project RAG re-index onto the worker queue.\n\nReturns the queued ``GenerationJob`` (status ``pending``) immediately;\npoll ``GET /jobs/{id}`` for progress (the worker flips it to running \u2192\ndone/failed and writes the index counts into ``output_data``). The worker\nresolves the embedding provider \u2014 when none is configured the job completes\nas a no-op (``output_data.skipped_no_provider = true``), never an error.\n\n``project_id`` may be given as a query param (preferred) or in the body.\nIf the queue cannot be reached, the job is marked failed (so it never\ndangles as forever-pending) and a sanitized 502 is returned.", "operationId": "index_project_async_api_v1_ai_index_async_post", "parameters": [{"in": "query", "name": "project_id", "required": false, "schema": {"anyOf": [{"format": "uuid", "type": "string"}, {"type": "null"}], "title": "Project Id"}}], "requestBody": {"content": {"application/json": {"schema": {"anyOf": [{"$ref": "#/components/schemas/IndexRequest"}, {"type": "null"}], "title": "Body"}}}}, "responses": {"202": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/GenerationJobRead"}}}, "description": "Successful Response"}, "422": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}, "description": "Validation Error"}}, "security": [{"OAuth2PasswordBearer": []}], "summary": "Index Project Async", "tags": ["ai"]}}, "/api/v1/ai/models": {"get": {"description": "Return the AI models the backend is configured to use.\n\nAggregated from the configured + enabled Provider rows (local Ollama + any\ncloud providers). The built-in Ollama default from settings is always\nincluded so the app works out of the box with no providers configured. Model\nnames are never hardcoded in the UI \u2014 it reads them from here.", "operationId": "list_models_api_v1_ai_models_get", "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ModelsResponse"}}}, "description": "Successful Response"}}, "security": [{"OAuth2PasswordBearer": []}], "summary": "List Models", "tags": ["ai"]}}, "/api/v1/ai/rewrite": {"post": {"operationId": "rewrite_api_v