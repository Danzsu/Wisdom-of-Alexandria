+
+# ── POST /ai/covers — validation 422s ────────────────────────────────────────
+
+
+async def test_post_cover_unknown_book_is_422(
+    client: AsyncClient, auth_headers: dict, db_session: AsyncSession
+):
+    resp = await client.post(
+        "/api/v1/ai/covers",
